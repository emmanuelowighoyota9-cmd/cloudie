{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    // Only the bun:test suites need bun's ambient types and the DOM
    // registrator, so they live in their own project: the app program stays a
    // pure browser program. @types/bun and @types/node are declared in
    // devDependencies so a clean CI install can typecheck this project.
    "types": ["bun", "node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/__tests__/**/*", "src/**/__tests__/**/*", "src/vite-env.d.ts"]
}
