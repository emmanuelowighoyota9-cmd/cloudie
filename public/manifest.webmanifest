{
  "name": "Crestline Express",
  "short_name": "Crestline",
  "description": "Crestline Express is a modern shipment platform for booking, tracking, documents, and delivery operations.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f3ee",
  "theme_color": "#0f766e",
  "categories": ["business", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Track a shipment",
      "short_name": "Track",
      "url": "/tracking",
      "description": "Look up a shipment by tracking number"
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "description": "Open the Crestline Express dashboard"
    },
    {
      "name": "Create shipment",
      "short_name": "Ship",
      "url": "/shipments/new",
      "description": "Create a new shipment"
    }
  ]
}
