# Copy to /etc/cloudieexpress/cloudieexpress.env on the VPS (deploy/bootstrap.sh
# does this for you the first time) and fill in the values there.
#
# Only PUBLIC values belong in this file — everything here is compiled into the
# browser bundle. Never put CONVEX_DEPLOY_KEY, LOGSPANEL_API_KEY or any provider
# secret in it; those live in the Convex deployment's environment variables.

# Which host nginx serves and release.sh verifies against.
DOMAIN=cloudieexpress.duckdns.org

# Where the published builds live (must match deploy/bootstrap.sh).
WEBROOT_ROOT=/var/www/cloudieexpress

# Production Convex deployment URL used at build time. Find it in the Convex
# dashboard under the production deployment ("Convex Deployment URL").
# This is the backend the frontend talks to for data, auth and file storage.
VITE_CONVEX_URL=https://example-deployment.convex.cloud
