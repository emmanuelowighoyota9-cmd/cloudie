{
  "name": "cloudie-neon-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/server.smoke.ts src/*.test.ts scripts/*.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "reconcile": "node scripts/reconcile-convex-migration.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hono": "^4.10.7",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
